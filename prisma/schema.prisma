generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(uuid())
  email         String?    @unique
  emailVerified DateTime?
  username      String?    @unique
  name          String?
  image         String?
  passwordHash  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  accounts      Account[]
  sessions      Session[]
  userCards     UserCard[]
  binders       Binder[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// 本專案採 JWT session（src/lib/auth.config.ts 的 session.strategy = 'jwt'），
/// session 狀態存在瀏覽器 cookie、伺服器不落地，故此表恆為空。
/// 但**不可移除**：@auth/prisma-adapter 依 database session 介面撰寫，拿掉 model 會使
/// Prisma Client 不生成 prisma.session、adapter 型別編譯失敗。改用 database session 時它已就位。
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CardSet {
  id          String    @id
  name        String
  series      String
  totalCards  Int
  releaseDate DateTime?
  symbolUrl   String?
  game        Game      @default(PTCG)
  language    Language  @default(EN)
  externalId  String    @default("")
  syncedAt    DateTime  @default(now())
  cards       Card[]
}

model Card {
  id                 String       @id @default(uuid())
  externalId         String
  language           Language     @default(EN)
  game               Game         @default(PTCG)
  name               String
  supertype          String
  subtypes           String[]
  hp                 Int?
  types              String[]
  setId              String
  set                CardSet      @relation(fields: [setId], references: [id])
  cardNumber         String
  rarity             String?
  imageSmall         String
  imageLarge         String
  syncedAt           DateTime     @default(now())
  attributes         Json?
  isCollectible      Boolean      @default(true)
  canonicalCardId    String?
  canonicalCard      Card?        @relation("CardAlias", fields: [canonicalCardId], references: [id], onDelete: SetNull)
  aliases            Card[]       @relation("CardAlias")
  userCards          UserCard[]   @relation("UserCardCanonical")
  binderSlots        BinderSlot[] @relation("BinderSlotCanonical")
  displayUserCards   UserCard[]   @relation("UserCardDisplay")
  displayBinderSlots BinderSlot[] @relation("BinderSlotDisplay")

  @@unique([game, language, externalId])
  @@index([setId, cardNumber])
  @@index([canonicalCardId])
  // 首頁 count(*) WHERE isCollectible 專用：選擇度低（true 佔 93%）不影響 index-only scan，
  // 讓 55 MB 的 heap Seq Scan 換成 ~1 MB 的索引掃描（Supabase 免費方案冷讀 IO 是真瓶頸）。
  @@index([isCollectible])
}

model UserCard {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId        String
  card          Card       @relation("UserCardCanonical", fields: [cardId], references: [id])
  displayCardId String?
  displayCard   Card?      @relation("UserCardDisplay", fields: [displayCardId], references: [id], onDelete: SetNull)
  status        CardStatus
  quantity      Int        @default(1)
  condition     String?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([userId, cardId, status])
}

model Binder {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  gridType    GridType
  coverColor  String       @default("#4A5568")
  description String?
  settings    Json?
  sortOrder   Int          @default(0)
  shareToken  String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  slots       BinderSlot[]
  slotGroups  BinderSlotGroup[]

  @@index([userId])
}

/// 跨格群組：一組相鄰格位共同呈現同一張來源圖（複數卡的官方合成圖各切一塊）。
/// 目前只由複數卡自動建立；`imageUrl` 為未來「使用者自訂跨格圖」預留（null = 用格位自己的卡圖）。
/// cols/rows 為**旋轉後**的實際佔格；原圖切法與旋轉映射由 src/lib/multi-card-layout.ts 決定。
model BinderSlotGroup {
  id        String       @id @default(uuid())
  binderId  String
  binder    Binder       @relation(fields: [binderId], references: [id], onDelete: Cascade)
  cols      Int
  rows      Int
  /// 順時針角度 0|90|180|270。LEGEND 為 270（＝逆時針 90°，上半張落左格）。
  rotation  Int          @default(0)
  imageUrl  String?
  createdAt DateTime     @default(now())
  slots     BinderSlot[]

  @@index([binderId])
}

model BinderSlot {
  id            String           @id @default(uuid())
  binderId      String
  binder        Binder           @relation(fields: [binderId], references: [id], onDelete: Cascade)
  cardId        String?
  card          Card?            @relation("BinderSlotCanonical", fields: [cardId], references: [id])
  displayCardId String?
  displayCard   Card?            @relation("BinderSlotDisplay", fields: [displayCardId], references: [id], onDelete: SetNull)
  status        CardStatus?
  pageNumber    Int
  slotIndex     Int
  createdAt     DateTime         @default(now())
  /// 跨格群組成員：群組內**每格都是自足的完整 row**（各自帶 cardId/displayCardId/status），
  /// 使既有「找空格」查詢（cardId: null）與 unique constraint 天然防重疊、無需感知群組。
  /// 代價是 quantity/統計須排除 groupIndex > 0（見 src/lib/binder-utils.ts）。
  groupId       String?
  group         BinderSlotGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// 0-based，row-major（0 = 左上 = anchor）
  groupIndex    Int?
  /// 使用者自訂的格位短註記（如圖鑑編號、稀有度、待換標記），可掛多個。
  /// 數量與字數上限見 src/lib/binder-limits.ts。跨格群組只掛 anchor（groupIndex 0）。
  labels        String[]

  @@unique([binderId, pageNumber, slotIndex])
  @@index([groupId])
}

enum Game {
  PTCG
  OPCG
}

enum Language {
  EN
  ZH_TW
  JA
}

enum CardStatus {
  owned
  wanted
}

enum GridType {
  grid_1x2
  grid_2x2
  grid_3x3
  grid_4x3
  grid_4x4
}
